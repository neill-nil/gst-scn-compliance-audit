# Copy this file to .env (never commit .env) and fill in your values.

# Gemini free tier: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `python -m src.common.llm models gemini` to see the exact model names your key can use, then pick a Flash model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Requests per minute to stay under. Check your project's limit in AI Studio.
GEMINI_RPM=12

# Local or Kaggle model server (vLLM: http://<host>:8000/v1, Ollama: http://localhost:11434/v1)
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL=Qwen/Qwen3-8B-AWQ
LOCAL_RPM=0
